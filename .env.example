# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# N8N Workflow Webhook URLs for ADVOCAT WALLA
N8N_WEBHOOK_URL="https://sneha92.app.n8n.cloud/webhook/advocatewalla-book-consultation"
N8N_CHAT_WEBHOOK_URL="https://sneha92.app.n8n.cloud/webhook/e4b448fe-d0a3-4afa-be23-de6261832b21/chat"
N8N_VIDEO_TOKEN_URL="https://sneha92.app.n8n.cloud/webhook/advocatewalla-video-token"
N8N_BOOK_CONSULTATION_URL="https://sneha92.app.n8n.cloud/webhook/advocatewalla-book-consultation"

# Telephony Provider (n8n_webhook | exotel | twilio | custom)
TELEPHONY_PROVIDER="n8n_webhook"

# Exotel Configuration (Optional for direct Exotel click-to-call)
EXOTEL_ACCOUNT_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_CALLER_ID=""

# Twilio Configuration (Optional for Twilio voice bridge)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

